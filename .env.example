# ---------------------------------------------------------------------------
# FundLens — environment template.
# Copy to `.env` and fill in. NEVER commit a populated .env file.
# In production these values must come from a secret manager
# (AWS Secrets Manager / GCP Secret Manager / Vault), not from a file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API -------------------------------------------------------------------
API_PORT=4000
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://fundlens:fundlens@localhost:5432/fundlens?schema=public

# --- Redis (cache + BullMQ queues) ----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# --- Market data provider --------------------------------------------------
# simulated | http
# `simulated` runs a deterministic synthetic feed so the product is fully
# usable in development without a paid market-data licence.
MARKET_DATA_PROVIDER=simulated
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_API_KEY_HEADER=x-api-key
# Requests/minute permitted by your licence agreement. The token-bucket
# limiter is sized from this value; never set it above your contract.
MARKET_DATA_RATE_LIMIT_PER_MIN=60
MARKET_DATA_BATCH_SIZE=50
MARKET_DATA_TIMEOUT_MS=8000
# Quotes older than this are flagged `stale` in every API response.
PRICE_STALE_AFTER_SECONDS=180
PRICE_REFRESH_INTERVAL_SECONDS=60

# --- Scheme master (AMFI public NAV file) ----------------------------------
AMFI_NAV_ALL_URL=https://www.amfiindia.com/spages/NAVAll.txt
SCHEME_MASTER_SYNC_CRON=0 30 22 * * *

# --- Portfolio disclosures -------------------------------------------------
# fixture | amc
# `fixture` reads bundled sample disclosures; `amc` enables the per-AMC
# downloader adapters (see docs/ARCHITECTURE.md#disclosure-ingestion).
DISCLOSURE_PROVIDER=fixture
DISCLOSURE_SYNC_CRON=0 0 3 * * *
DISCLOSURE_STALE_AFTER_DAYS=75

# --- AI assistant ----------------------------------------------------------
# When unset the assistant falls back to the deterministic rule-based parser,
# which answers the supported question set without any LLM call.
AI_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_MAX_TOKENS=1200
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT_PER_MIN=20

# --- Feature flags / ops ---------------------------------------------------
ENABLE_BACKGROUND_JOBS=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_PRICE_REFRESH_SECONDS=60
