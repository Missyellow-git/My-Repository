# Required for generation: your Anthropic API key
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: where decks and uploaded images are stored (default: ./.data)
# DATA_DIR=/var/lib/carousel-studio

# Optional: use a specific Chromium/Chrome for PNG export
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
